{% extends 'base.html.twig' %}

{% block title %}Malta Beyblade Community League | Season 1 Framework{% endblock %}

{% block body %}

    <twig:PageHeader
        eyebrow="Official league framework"
        title="Malta Beyblade Community"
        highlight="League Season 1"
        highlightTone="brand"
        class="mb-16 space-y-4 text-center"
    >
        For <strong>the players</strong> By <strong>the players</strong>
    </twig:PageHeader>

    <twig:Flashes />

    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-3">

        <twig:Card class="relative flex flex-col justify-between overflow-hidden md:col-span-2">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-brand-strong/10 blur-xl" aria-hidden="true"></div>
            <div>
                <h3 class="mb-2 text-xs font-bold uppercase tracking-widest text-ink-muted">Duration</h3>
                <h2 class="mb-4 text-2xl font-black text-ink md:text-3xl">Season timeline</h2>
                <div class="flex flex-col justify-between gap-4 rounded-field border border-line/50 bg-canvas/60 p-4 sm:flex-row sm:items-center">
                    <div>
                        <p class="text-xs font-bold uppercase text-brand">Start date</p>
                        <p class="text-xl font-extrabold text-ink">4 July 2026</p>
                    </div>
                    <div class="hidden font-bold text-ink-ghost sm:block" aria-hidden="true">&rarr;</div>
                    <div>
                        <p class="text-xs font-bold uppercase text-heat">Conclusion</p>
                        <p class="text-xl font-extrabold text-ink">4 November 2026</p>
                    </div>
                </div>
            </div>
        </twig:Card>

        <div class="flex flex-col justify-between gap-6 rounded-card border border-flame-strong/20 bg-linear-to-b from-flame-strong/10 to-transparent p-6 shadow-xl sm:p-8">
            <div>
                <h3 class="mb-2 text-xs font-bold uppercase tracking-widest text-flame">Registration</h3>
                <h2 class="mb-2 text-2xl font-black text-ink">Entry fee price</h2>
            </div>
            <div class="my-2">
                <span class="text-5xl font-black text-ink">20 Euro</span>
                <span class="mt-1 block text-sm font-semibold text-ink-muted">Per blader for Season 1</span>
            </div>
            <div class="rounded-control border border-flame-strong/10 bg-flame-strong/5 p-3 text-xs font-medium leading-relaxed text-flame-bright/80">
                📝 <strong>Sign-ups</strong> open before and during month 1 of the season.
            </div>
        </div>

    </div>

    <div class="mb-12 space-y-6">

        <twig:Card size="lg">
            <twig:SectionHeading title="Points & standings system" rule />

            <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
                <twig:FeatureTile icon="🏎️" title="Points allocation">
                    Calculated from your <strong>best 14 tournaments</strong> held throughout Season 1.
                </twig:FeatureTile>
                <twig:FeatureTile icon="📊" title="Formula One structure">
                    Points system tracks 1st to 10th place points to determine competitive distributions.
                </twig:FeatureTile>
                <twig:FeatureTile icon="🏆" title="Determining the winner">
                    The player with the most points at the end of the season from their best 14 tournaments will be the
                    winner (1<sup>st</sup>).
                </twig:FeatureTile>
            </div>

            <div class="mb-6 rounded-field border border-line bg-canvas p-4 text-sm leading-relaxed text-ink-body">
                🔍 <strong class="text-ink">Points extraction:</strong> Points will be extracted from the final scoreboards. <br>
                While <strong>swiss + knockout tournaments</strong> are heavily encouraged as the fairest form of competition. <br>
                Swiss only tournaments will be included also <u>as long as the minimum number of 10 players is met.</u>
            </div>

            <twig:Disclosure summary="View F1 points allocation matrix" icon="📊">
                <twig:PointsMatrix :awards="[
                    '25 points', '18 points', '15 points', '12 points', '10 points',
                    '8 points', '6 points', '4 points', '2 points', '1 points',
                ]" />
            </twig:Disclosure>
        </twig:Card>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

            <twig:Card class="flex flex-col justify-between gap-4">
                <div>
                    <twig:SectionHeading title="Eligible format & styles" tone="heat" size="sm" />
                    <p class="mb-3 text-sm leading-relaxed text-ink-body">
                        To maintain standard ranking integrity, only official events matching these precise configurations qualify:
                    </p>
                </div>
                <div class="space-y-2 rounded-field border border-line bg-canvas p-4 text-sm">
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold uppercase text-ink-muted">Tournaments eligible</span>
                        <span class="font-semibold text-ink">Open Gamesplus and Open Gamebreaker tournaments of a minimum of 10 players or more.</span>
                        <span class="font-semibold text-ink">Any other eligible tournaments will be communicated from before the tournament starts.</span>
                    </div>
                    <div class="my-1 h-px bg-line"></div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold uppercase text-ink-muted">Tournament styles allowed</span>
                        <span class="font-semibold text-flame">Swiss + knockout encouraged but not enforced</span>
                        <span class="font-semibold text-flame">The main hard requirements are the minimum of 10 players, and that the tournament must be open to all players and not limited by any means.</span>
                    </div>
                </div>
            </twig:Card>

            <twig:Card class="flex flex-col justify-between gap-4">
                <div>
                    <twig:SectionHeading title="Entry fee usage & prizes" tone="positive" size="sm" />
                    <p class="text-sm leading-relaxed text-ink-body">
                        Every single euro collected via registration fees remains completely inside the competitive community framework.
                    </p>
                </div>

                <div class="space-y-3">
                    <div class="flex items-start gap-2 rounded-field border border-line/50 bg-canvas/40 p-3 text-sm">
                        <span class="font-bold text-positive" aria-hidden="true">✓</span>
                        <p class="text-ink-body">
                            <strong class="text-ink">Entry fee usage:</strong> Full usage all the entry fees collected will be used as prizes + trophy + sponsorships or contributions from stores.
                        </p>
                    </div>
                    <div class="flex items-start gap-2 rounded-field border border-line/50 bg-canvas/40 p-3 text-sm">
                        <span class="font-bold text-positive" aria-hidden="true">✓</span>
                        <p class="text-ink-body">
                            <strong class="text-ink">Prize allocation:</strong> Structured payouts across positions <span class="font-semibold text-ink">1st &ndash; 5th place</span> at the end of the season framework.
                        </p>
                    </div>
                </div>
            </twig:Card>

        </div>

    </div>

    {% set tentative_bladers = [
        'Derius', 'Giglio', 'Kemical', 'Obelix', 'L-anzjan',
        'Mezz', 'il-karm', 'Shadowblade', 'Beastblade',
        'Markulegend', 'Il-butcher', 'Faenza', 'il-belti'
    ] %}

    <twig:Card size="lg" class="mb-6">
        <div class="mb-8 flex flex-col justify-between gap-5 border-b border-line/60 pb-6 text-center sm:flex-row sm:items-center sm:text-left">
            <div>
                <twig:SectionHeading title="Tentative blader roster" size="lg" class="mb-1 justify-center sm:justify-start" />
                <p class="mx-auto max-w-md text-sm text-ink-muted sm:mx-0">Current unconfirmed list of competitors expressing entry intent for Season 1</p>
            </div>

            <div class="mx-auto whitespace-nowrap rounded-field border border-line bg-canvas px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-ink-muted shadow-inner sm:mx-0">
                Current total intent: <span class="ml-1.5 text-sm font-black text-brand">{{ tentative_bladers|length }} bladers</span>
            </div>
        </div>

        <div class="grid grid-cols-1 justify-center gap-3 sm:grid-cols-2 md:grid-cols-3">
            {% for blader in tentative_bladers %}
                <div class="group flex items-center justify-center rounded-field border border-line/80 bg-canvas/60 p-3.5 transition-all duration-200 hover:border-brand-strong/40 hover:bg-canvas">
                    <h3 class="text-base font-bold tracking-wide text-ink-strong transition-colors group-hover:text-ink">{{ blader }}</h3>
                </div>
            {% endfor %}
        </div>
    </twig:Card>

    {{ include('league/_governance.html.twig') }}

{% endblock %}
