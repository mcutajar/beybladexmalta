{% extends 'base.html.twig' %}

{% block title %}MBC League | Seasonal Registrations{% endblock %}

{% block column %}max-w-5xl px-3 py-8 sm:px-4 md:py-12{% endblock %}

{% block body %}

    <twig:BackLink href="{{ path('app_league_proposal_v2') }}" class="mb-8">Return to hub</twig:BackLink>

    <twig:PageHeader
        eyebrow="Financial clearance system"
        title="Malta Community Beyblade"
        highlight="Paid registrations"
    >
        For <strong>the players</strong> By <strong>the players</strong>
    </twig:PageHeader>

    <twig:Flashes />

    <div class="space-y-12">
        {% for season_name, players in grouped_payments %}

            <twig:Card variant="gradient" class="space-y-6">

                <div class="space-y-1">
                    <twig:Badge size="sm">🔥 Active season</twig:Badge>
                    <h2 class="text-2xl font-black uppercase tracking-tight text-ink">{{ season_name }}</h2>
                    <p class="text-xs text-ink-muted">Verified entry ledger tracking real clearance distributions.</p>
                </div>

                <twig:DataTable class="rounded-field border border-line/60 bg-canvas/40">
                    <thead>
                    <tr>
                        <th scope="col" class="w-16 text-center">#</th>
                        <th scope="col">Blader name</th>
                        <th scope="col" class="w-36 text-right">Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for p in players %}
                        <tr class="group">
                            <td class="whitespace-nowrap text-center font-mono text-xs font-bold text-ink-faint">
                                {{ loop.index }}
                            </td>
                            <td class="whitespace-nowrap">
                                <a href="{{ path('player_season_details', {'slug': p.season_slug, 'id': p.player_id}) }}"
                                   class="text-sm font-bold tracking-wide text-ink-strong transition-colors outline-none group-hover:text-brand focus:text-brand">
                                    {{ p.player_name }}
                                </a>
                            </td>
                            <td class="whitespace-nowrap text-right">
                                <twig:Badge tone="positive" size="sm">Paid ✓</twig:Badge>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </twig:DataTable>

            </twig:Card>
        {% else %}
            <twig:EmptyState title="Ledger unpopulated">
                No verified entry payments or seasonal registrations have been processed in the database ledger container yet.
            </twig:EmptyState>
        {% endfor %}
    </div>

{% endblock %}
