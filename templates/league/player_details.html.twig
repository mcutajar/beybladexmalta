{% extends 'base.html.twig' %}

{% block title %}{{ player.name }} | Tournament Breakdown{% endblock %}

{% block body %}

    <twig:BackLink href="{{ path('season_leaderboard', {'slug': current_season.slug}) }}" class="mb-6">
        Return to {{ current_season.name }} leaderboard
    </twig:BackLink>

    <twig:PageHeader eyebrow="Blader performance profile" title="{{ player.name }}" size="md">
        Reviewing individual tournament contributions (top 14 limit)
    </twig:PageHeader>

    <twig:Card>
        <twig:DataTable>
            <thead>
            <tr>
                <th>Tournament</th>
                <th class="text-center">Date held</th>
                <th class="text-center">Base F1 pts</th>
                <th class="text-center">KO/bonus pts</th>
                <th class="pr-4 text-right font-bold text-brand">Total</th>
            </tr>
            </thead>
            <tbody>
            {% for match in contributions %}
                <tr>
                    <td>
                        <a href="{{ path('tournament_details', {'slug': current_season.slug, 'id': match.tournament_id}) }}"
                           class="font-bold text-ink transition-colors outline-none hover:text-brand focus:text-brand">
                            {{ match.tournament_name }}
                        </a>
                    </td>
                    <td class="text-center font-mono text-xs text-ink-muted">{{ match.held_on|date('Y-m-d') }}</td>
                    <td class="text-center">{{ match.f1_points }}</td>
                    <td class="text-center">
                        <twig:BonusPoints :value="match.bonus_points" />
                    </td>
                    <td class="pr-4 text-right font-black text-ink">
                        {{ match.total_points }} <span class="text-xs font-normal text-ink-faint">pts</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="py-12 text-center text-sm italic text-ink-faint">No registered records under active seasonal criteria.</td>
                </tr>
            {% endfor %}
            </tbody>
        </twig:DataTable>
    </twig:Card>

{% endblock %}
