{#
    The first of the three league proposals.

    It deliberately looks different from v1 and v2 — glass surfaces, a radial
    backdrop and a thinner sticky accent — so those choices stay here as local
    overrides while the shared vocabulary comes from the components.
#}
{% extends 'base.html.twig' %}

{% block title %}Malta Beyblade Community League | Season 1 Proposal{% endblock %}

{% block html_classes %}scroll-smooth{% endblock %}

{% block body_classes %}bg-radial-[ellipse_at_top] from-surface via-canvas to-canvas{% endblock %}

{% block accent_bar %}
    <div class="sticky top-0 z-50 h-1.5 w-full bg-linear-to-r from-brand-strong via-flame-strong to-heat-strong"></div>
{% endblock %}

{% block column %}max-w-5xl px-3 py-8 sm:px-6 md:py-16 lg:py-20{% endblock %}

{% block body %}

    <twig:PageHeader
        eyebrow="Official league proposal"
        title="Malta Beyblade"
        highlight="Community League"
        highlightTone="brand"
        class="mb-12 space-y-5 text-center md:mb-20"
    >
        <span class="text-lg font-bold uppercase tracking-widest text-flame md:text-xl">Season 1 core framework</span>
    </twig:PageHeader>

    <twig:Flashes />

    <div class="mb-12 grid grid-cols-1 gap-5 md:gap-6 lg:grid-cols-3 md:mb-16">

        <twig:Card variant="glass" size="lg" class="relative overflow-hidden lg:col-span-2">
            <div class="pointer-events-none absolute -top-10 -right-10 h-40 w-40 rounded-full bg-brand-strong/10 blur-3xl" aria-hidden="true"></div>

            <div class="mb-6 flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-field border border-line bg-surface-raised text-brand" aria-hidden="true">⏱️</div>
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-widest text-ink-muted">Duration</h3>
                    <h2 class="text-xl font-black text-ink md:text-2xl">Season timeline</h2>
                </div>
            </div>

            <div class="flex flex-col justify-between gap-4 rounded-card border border-line/80 bg-canvas/80 p-5 sm:flex-row">
                <div class="flex-1">
                    <p class="mb-1 text-xs font-bold uppercase tracking-wider text-brand-strong">Launch date</p>
                    <p class="text-lg font-extrabold text-ink md:text-xl">4th July 2026</p>
                </div>

                <div class="hidden items-center justify-center text-ink-ghost sm:flex" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </div>
                <div class="my-2 h-px w-full bg-line sm:hidden"></div>

                <div class="flex-1 sm:text-right">
                    <p class="mb-1 text-xs font-bold uppercase tracking-wider text-heat-strong">Conclusion</p>
                    <p class="text-lg font-extrabold text-ink md:text-xl">4th October 2026</p>
                </div>
            </div>
        </twig:Card>

        <div class="relative flex flex-col justify-between gap-6 overflow-hidden rounded-panel border border-flame-strong/30 bg-linear-to-br from-bronze/40 to-surface p-6 shadow-2xl md:p-8">
            <div class="pointer-events-none absolute top-0 right-0 h-32 w-32 rounded-full bg-flame-strong/10 blur-3xl" aria-hidden="true"></div>
            <div>
                <h3 class="mb-1 text-xs font-bold uppercase tracking-widest text-flame-strong/80">Registration</h3>
                <h2 class="text-xl font-black text-ink md:text-2xl">Entry fee</h2>
            </div>

            <div>
                <div class="flex items-baseline gap-1">
                    <span class="bg-linear-to-b from-ink to-flame-bright bg-clip-text text-5xl font-black text-transparent md:text-6xl">&euro;25</span>
                </div>
                <span class="mt-2 block text-sm font-semibold uppercase tracking-wide text-flame-bright/60">Per blader / Season 1</span>
            </div>

            <div class="flex items-start gap-3 rounded-field border border-flame-strong/20 bg-canvas/40 p-3.5 backdrop-blur-md">
                <span class="text-lg text-flame" aria-hidden="true">🛡️</span>
                <p class="text-xs font-medium leading-relaxed text-flame-bright/80">Managed with absolute financial transparency.</p>
            </div>
        </div>

    </div>

    <div class="mb-12 space-y-6 md:mb-16 md:space-y-8">

        <twig:Card variant="glass" size="lg">
            <twig:SectionHeading title="Points & standings system" size="lg" rule />

            <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6">
                <twig:FeatureTile icon="🏎️" title="Formula 1 structure">
                    Ranking points are awarded at the end of <strong class="font-bold text-ink-strong">every tournament</strong> exclusively to the top 10 placing players.
                </twig:FeatureTile>
                <twig:FeatureTile icon="🔹" title="The best 12 rule">
                    To allow for missed events, final standings are calculated using only each blader's <strong class="font-bold text-ink-strong">top 12 performances</strong>.
                </twig:FeatureTile>
                <twig:FeatureTile icon="🏆" title="Determining the winner">
                    The player aggregating the highest cumulative points from their best 12 placements wins the championship.
                </twig:FeatureTile>
            </div>

            <twig:Disclosure summary="View F1 points allocation matrix" icon="📊">
                <twig:PointsMatrix medals :awards="[
                    '25', '18', '15', '12', '10', '8', '6', '4', '2', '1',
                ]" />
            </twig:Disclosure>
        </twig:Card>

        <div class="grid grid-cols-1 gap-5 md:gap-6 lg:grid-cols-2">

            <twig:Card variant="glass" size="lg" class="flex flex-col justify-between">
                <div class="mb-6">
                    <twig:SectionHeading title="Eligible format structure" tone="heat" size="sm" shape="diamond" class="mb-3 uppercase tracking-wide" />
                    <p class="text-sm leading-relaxed text-ink-muted">
                        To maintain ranking integrity, only events meeting the following criteria qualify for tracking:
                    </p>
                </div>
                <dl class="flex flex-col overflow-hidden rounded-card border border-line bg-canvas text-sm">
                    <div class="flex flex-col justify-between gap-1 border-b border-line/50 p-4 transition-colors hover:bg-surface/50 sm:flex-row sm:items-center">
                        <dt class="font-medium text-ink-faint">Match format</dt>
                        <dd class="font-bold text-ink">5-round swiss system</dd>
                    </div>
                    <div class="flex flex-col justify-between gap-1 border-b border-line/50 p-4 transition-colors hover:bg-surface/50 sm:flex-row sm:items-center">
                        <dt class="font-medium text-ink-faint">Target score limit</dt>
                        <dd class="font-bold text-flame">7-point settings</dd>
                    </div>
                    <div class="flex flex-col justify-between gap-1 p-4 transition-colors hover:bg-surface/50 sm:flex-row sm:items-center">
                        <dt class="font-medium text-ink-faint">Final stage bracket</dt>
                        <dd class="font-bold text-ink">King + knock out only</dd>
                    </div>
                </dl>
            </twig:Card>

            <twig:Card variant="glass" size="lg" class="flex flex-col justify-between">
                <div class="mb-6">
                    <twig:SectionHeading title="Prize pool breakdown" tone="positive" size="sm" shape="diamond" class="mb-3 uppercase tracking-wide" />
                    <p class="text-sm leading-relaxed text-ink-muted">
                        Every collected euro via registration remains completely inside the competitive community.
                    </p>
                </div>

                <div class="space-y-3">
                    <div class="flex items-start gap-4 rounded-card border border-line bg-canvas p-4 text-sm transition-colors hover:border-positive-strong/30">
                        <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-positive-strong/20 bg-positive-strong/10 text-positive" aria-hidden="true">✓</div>
                        <p class="leading-relaxed text-ink-muted">
                            <strong class="mb-0.5 block text-ink">Full usage framework</strong> 100% of collected entry fees convert directly into the performance prize pool.
                        </p>
                    </div>
                    <div class="flex items-start gap-4 rounded-card border border-line bg-canvas p-4 text-sm transition-colors hover:border-positive-strong/30">
                        <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-positive-strong/20 bg-positive-strong/10 text-positive" aria-hidden="true">✓</div>
                        <p class="leading-relaxed text-ink-muted">
                            <strong class="mb-0.5 block text-ink">Tier distribution</strong> The resource pool provides financial payouts across <span class="font-bold text-positive">1st through 5th place</span> at season end.
                        </p>
                    </div>
                </div>
            </twig:Card>

        </div>

    </div>

    {{ include('league/_governance.html.twig') }}

{% endblock %}
