{#
    The records board — option 5B of the design proposal, "hall of records".

    One expandable tile per record, each naming the holder and opening into a
    compact top three for that same record.

    Everything on this page is counted from archived matches. `TournamentResult`
    is not read at all, so no league points appear in either scope — they are
    season-specific, and the season leaderboard remains the place for them.
#}
{% extends 'base.html.twig' %}

{% block title %}League records | Malta Beyblade Community League{% endblock %}

{% block body %}

    {# A season-scoped board goes back to that season's table; the Overall
       board has no season to go back to, so it goes to the index. #}
    {% if current_season %}
        <twig:BackLink href="{{ path('season_leaderboard', {'slug': current_season.slug}) }}" class="mb-6">
            Return to {{ current_season.name }} leaderboard
        </twig:BackLink>
    {% else %}
        <twig:BackLink href="{{ path('seasons_index') }}" class="mb-6">
            Return to every season
        </twig:BackLink>
    {% endif %}

    <header class="mb-12 text-center">
        <h1 class="text-3xl font-black uppercase tracking-tight text-ink md:text-4xl">
            Malta Beyblade Community Records
        </h1>
    </header>

    <div class="mb-8 flex justify-center" data-page-section="scope">
        <twig:ScopeSwitch
            route="records_board"
            :seasons="seasons"
            :activeSlug="current_season ? current_season.slug : null"
        />
    </div>

    {% if board.archived %}
        {# One column on a phone with no compromise: a record tile is a label,
           a name and a number, and it has nothing to drop. #}
        <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" data-page-section="records">
            {% for record in board.records %}
                <twig:RecordTile
                    label="{{ record.label }}"
                    :name="record.name"
                    :value="record.value"
                    :note="record.note"
                    :leaders="record.leaders"
                    tone="{{ record.tone }}"
                    seasonSlug="{{ profile_season_slug }}"
                    data-record="{{ record.key }}"
                />
            {% endfor %}
        </div>

    {% else %}
        <div data-page-section="records-empty">
            <twig:EmptyState icon="🗃️" title="Nothing archived yet">
                No bracket in this scope has been archived, so there is no match to count a record from.
                The board fills itself in the moment one is.
            </twig:EmptyState>
        </div>
    {% endif %}

{% endblock %}
