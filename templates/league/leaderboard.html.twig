{% extends 'base.html.twig' %}

{% block title %}Malta Beyblade Community League | {{ current_season.name }} Leaderboard{% endblock %}

{% block body %}

    <twig:BackLink href="{{ path('app_league_proposal_v2') }}" class="mb-6">Return to league framework</twig:BackLink>

    <twig:PageHeader
        eyebrow="League standings"
        title="Malta Beyblade Community"
        highlight="{{ current_season.name }} standings"
    >
        For <strong>the players</strong> By <strong>the players</strong>
    </twig:PageHeader>

    <twig:Flashes />

    <twig:Card>

        <div class="mb-6 flex flex-col items-center gap-5 border-b border-line/60 pb-6 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
            {#
                The heading above already names the season, so this row carries
                what it does not: how a total is arrived at.
            #}
            <div>
                <h2 class="text-xl font-black uppercase tracking-tight text-ink md:text-2xl">How the points add up</h2>
                <p class="mx-auto mt-1 max-w-md text-sm text-ink-muted sm:mx-0">
                    Every qualifying tournament counts, but only each blader's best 14 results go towards the title.
                </p>
            </div>

            <div class="whitespace-nowrap rounded-field border border-line bg-canvas px-5 py-2.5 uppercase tracking-wide shadow-inner">
                <span class="mb-0.5 block text-xs font-bold text-ink-muted">Ruleset engine</span>
                <span class="text-sm font-black text-brand">F1 structure + top cut bonus</span>
            </div>
        </div>

        <twig:DataTable bleed>
            <thead>
            <tr>
                <th class="w-12 text-center sm:w-16">Rank</th>
                <th>Blader name</th>
                <th class="hidden text-center sm:table-cell">Last active</th>
                <th class="text-center">Base F1</th>
                <th class="text-center">KO win</th>
                <th class="pr-4 text-right font-bold text-brand sm:pr-8">Total</th>
            </tr>
            </thead>
            <tbody>
            {% for player in leaderboard_data %}
                <tr class="group">
                    <td class="text-center">
                        <twig:RankMedal :rank="player.rank" />
                    </td>

                    <td>
                        {# The date is inside the link so the whole two-line block
                           is one touch target on a phone. #}
                        <a href="{{ path('player_season_details', {'slug': current_season.slug, 'id': player.id}) }}"
                           class="flex flex-col gap-0.5 font-bold text-ink transition-colors outline-none group-hover:text-brand focus:text-brand sm:flex-row sm:items-center sm:gap-2.5">
                            {{ player.name }}
                            <span class="font-mono text-[10px] font-normal text-ink-faint sm:hidden">
                                Active: {{ player.last_active|date('d M Y') }}
                            </span>
                        </a>
                    </td>

                    <td class="hidden text-center font-mono text-xs text-ink-muted sm:table-cell">
                        {{ player.last_active|date('Y-m-d') }}
                    </td>

                    <td class="text-center font-semibold">
                        {{ player.base_f1 }} <span class="text-[10px] font-normal text-ink-faint sm:hidden">pts</span>
                    </td>

                    <td class="text-center">
                        <twig:BonusPoints :value="player.total_bonus" chip />
                    </td>

                    <td class="pr-4 text-right text-base font-black text-ink sm:pr-8">
                        {{ player.total }}<span class="ml-0.5 hidden text-xs font-normal text-ink-faint sm:inline">pts</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="py-12 text-center text-sm italic text-ink-faint">No standings recorded for this season yet.</td>
                </tr>
            {% endfor %}
            </tbody>
        </twig:DataTable>

    </twig:Card>

{% endblock %}
