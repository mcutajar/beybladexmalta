{#
    The component gallery.

    Every component in every variant, on one page, so a change to the design
    system can be looked at rather than guessed at. Reachable at /_styleguide
    in dev and test only — see config/routes/styleguide.yaml.
#}
{% extends 'base.html.twig' %}

{% block title %}Design system | Malta Beyblade Community League{% endblock %}

{% block body %}

    <twig:PageHeader eyebrow="Internal" title="Design system" highlight="Components & tokens" size="md">
        Every component in every variant. Not routed in production.
    </twig:PageHeader>

    {# Each section is anchored, so /_styleguide#data-table opens on it. #}
    <nav class="mb-8 flex flex-wrap justify-center gap-2">
        {% for anchor, label in {
            'tokens': 'Tokens', 'radii': 'Radii', 'badge': 'Badge', 'button': 'Button',
            'alert': 'Alert', 'card': 'Card', 'section-heading': 'Section heading',
            'form-controls': 'Form controls', 'data-table': 'Data table', 'expandable-table': 'Expandable table',
            'feature-tiles': 'Feature tiles', 'link-cards': 'Link cards',
            'disclosure': 'Disclosure', 'empty-state': 'Empty state',
            'form-strip': 'Form strip', 'match-log': 'Match log', 'top-cut': 'Top cut',
            'kpi-row': 'KPI row', 'totals-list': 'Totals list',
            'scope-switch': 'Scope switch', 'record-tile': 'Record tile',
            'player-headline': 'Player headline', 'h2h-bars': 'Head-to-head bars',
            'cut-path': 'Cut path', 'player-match-log': 'Player match log', 'event-feed': 'Event feed',
            'finishing-order': 'Finishing order', 'archive-row': 'Archive row',
            'season-index': 'Season index',
            'artifacts': 'Artifacts & ledger',
        } %}
            <a href="#{{ anchor }}" class="rounded-control border border-line bg-surface px-2.5 py-1 text-[11px] font-semibold text-ink-muted transition-colors hover:text-ink">{{ label }}</a>
        {% endfor %}
    </nav>

    {% set swatches = [
        {name: 'canvas', class: 'bg-canvas'},
        {name: 'surface', class: 'bg-surface'},
        {name: 'surface-raised', class: 'bg-surface-raised'},
        {name: 'line', class: 'bg-line'},
        {name: 'ink', class: 'bg-ink'},
        {name: 'ink-bright', class: 'bg-ink-bright'},
        {name: 'ink-strong', class: 'bg-ink-strong'},
        {name: 'ink-body', class: 'bg-ink-body'},
        {name: 'ink-muted', class: 'bg-ink-muted'},
        {name: 'ink-faint', class: 'bg-ink-faint'},
        {name: 'ink-ghost', class: 'bg-ink-ghost'},
        {name: 'brand-bright', class: 'bg-brand-bright'},
        {name: 'brand', class: 'bg-brand'},
        {name: 'brand-strong', class: 'bg-brand-strong'},
        {name: 'flame-bright', class: 'bg-flame-bright'},
        {name: 'flame', class: 'bg-flame'},
        {name: 'flame-strong', class: 'bg-flame-strong'},
        {name: 'heat', class: 'bg-heat'},
        {name: 'heat-strong', class: 'bg-heat-strong'},
        {name: 'positive', class: 'bg-positive'},
        {name: 'positive-strong', class: 'bg-positive-strong'},
        {name: 'info', class: 'bg-info'},
        {name: 'silver', class: 'bg-silver'},
        {name: 'bronze', class: 'bg-bronze'},
    ] %}
    {# Loop variables are named away from the components' own props: a content
       block renders in the child component's context, so `tone` inside a
       <twig:Badge> would resolve to the badge's own tone, not the loop's. #}
    {% set tones = ['brand', 'flame', 'positive', 'heat', 'info', 'neutral'] %}

    <div class="space-y-8">

        <twig:Card id="tokens">
            <twig:SectionHeading title="Colour tokens" rule />
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-6">
                {% for swatch in swatches %}
                    <div class="space-y-1.5">
                        <div class="h-12 rounded-control border border-line {{ swatch.class }}"></div>
                        <p class="font-mono text-[11px] text-ink-muted">{{ swatch.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </twig:Card>

        <twig:Card id="radii">
            <twig:SectionHeading title="Radii" rule />
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                {% for radius in ['rounded-control', 'rounded-field', 'rounded-card', 'rounded-panel'] %}
                    <div class="space-y-1.5">
                        <div class="h-16 border border-line bg-surface-raised {{ radius }}"></div>
                        <p class="font-mono text-[11px] text-ink-muted">{{ radius }}</p>
                    </div>
                {% endfor %}
            </div>
        </twig:Card>

        <twig:Card id="badge">
            <twig:SectionHeading title="Badge" rule />
            <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    {% for toneName in tones %}
                        <twig:Badge tone="{{ toneName }}">{{ toneName }}</twig:Badge>
                    {% endfor %}
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    {% for toneName in tones %}
                        <twig:Badge tone="{{ toneName }}" size="sm">{{ toneName }}</twig:Badge>
                    {% endfor %}
                </div>
            </div>
        </twig:Card>

        <twig:Card id="button">
            <twig:SectionHeading title="Button" rule />
            <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    {% for toneName in tones %}
                        <twig:Button tone="{{ toneName }}" type="button">{{ toneName }}</twig:Button>
                    {% endfor %}
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    {% for toneName in tones %}
                        <twig:Button tone="{{ toneName }}" variant="gradient" type="button">{{ toneName }}</twig:Button>
                    {% endfor %}
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <twig:Button href="#buttons">As a link</twig:Button>
                    <twig:BackLink href="#buttons">BackLink</twig:BackLink>
                </div>
            </div>
        </twig:Card>

        <twig:Card id="alert">
            <twig:SectionHeading title="Alert" rule />
            <div class="space-y-3">
                {% for toneName in tones %}
                    <twig:Alert tone="{{ toneName }}">A {{ toneName }} notice. Flash messages render through this.</twig:Alert>
                {% endfor %}
            </div>
        </twig:Card>

        <twig:Card id="card">
            <twig:SectionHeading title="Card" rule />
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                {% for variantName in ['solid', 'gradient', 'glass'] %}
                    {% for sizeName in ['sm', 'md', 'lg'] %}
                        <twig:Card variant="{{ variantName }}" size="{{ sizeName }}">
                            <p class="font-mono text-xs text-ink-muted">{{ variantName }} / {{ sizeName }}</p>
                        </twig:Card>
                    {% endfor %}
                {% endfor %}
            </div>
        </twig:Card>

        <twig:Card id="section-heading">
            <twig:SectionHeading title="Section heading" rule />
            <div class="space-y-2">
                <twig:SectionHeading title="Small, heat" tone="heat" size="sm" />
                <twig:SectionHeading title="Medium, brand" size="md" />
                <twig:SectionHeading title="Large, info, diamond" tone="info" size="lg" shape="diamond" />
                <twig:SectionHeading title="Medium with a rule" size="md" rule />
            </div>
        </twig:Card>

        <twig:Card id="form-controls">
            <twig:SectionHeading title="Form controls" rule />
            <form class="space-y-4" onsubmit="return false">
                <twig:Field label="Text field" hint="A hint sits under the control.">
                    <input type="text" class="field" placeholder="Enter blader name">
                </twig:Field>
                <twig:Field label="Select">
                    <select class="field"><option>Season 1</option><option>Preseason 1</option></select>
                </twig:Field>
                <twig:Field label="Textarea">
                    <textarea class="field font-mono" rows="3" placeholder="One name per line"></textarea>
                </twig:Field>
                <twig:Button type="button" class="w-full">Submit</twig:Button>
            </form>
        </twig:Card>

        <twig:Card id="data-table">
            <twig:SectionHeading title="Data table" rule />
            <twig:DataTable compact>
                <thead>
                <tr>
                    <th class="w-16 text-center">Rank</th>
                    <th>Blader name</th>
                    <th class="text-center">KO win</th>
                    <th class="pr-4 text-right font-bold text-brand">Total</th>
                </tr>
                </thead>
                <tbody>
                {% for row in [
                    {rank: 1, name: 'Derius', bonus: 10, total: 231},
                    {rank: 2, name: 'Giglio', bonus: 10, total: 198},
                    {rank: 3, name: 'Kemical', bonus: 0, total: 176},
                    {rank: 4, name: 'Obelix', bonus: 0, total: 154},
                ] %}
                    <tr>
                        <td class="text-center"><twig:RankMedal :rank="row.rank" /></td>
                        <td class="font-bold text-ink">{{ row.name }}</td>
                        <td class="text-center"><twig:BonusPoints :value="row.bonus" chip /></td>
                        <td class="pr-4 text-right font-black text-ink">{{ row.total }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </twig:DataTable>
        </twig:Card>

        <twig:Card id="expandable-table">
            <twig:SectionHeading title="Expandable table" rule />
            <twig:ExpandableTable :initialRows="2">
                <twig:DataTable dense>
                    <thead><tr><th>Blader</th><th class="text-right">Points</th></tr></thead>
                    <tbody>
                    {% for row in [
                        {name: 'Derius', points: 231},
                        {name: 'Giglio', points: 198},
                        {name: 'Kemical', points: 176},
                        {name: 'Obelix', points: 154},
                    ] %}
                        <tr><td class="font-bold text-ink">{{ row.name }}</td><td class="text-right">{{ row.points }}</td></tr>
                    {% endfor %}
                    </tbody>
                </twig:DataTable>
            </twig:ExpandableTable>
        </twig:Card>

        <twig:Card id="feature-tiles">
            <twig:SectionHeading title="Feature tiles" rule />
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                <twig:FeatureTile icon="🏎️" title="With an icon">The emoji is optional.</twig:FeatureTile>
                <twig:FeatureTile title="Without one">Copy sits in the content block.</twig:FeatureTile>
                <twig:FeatureTile icon="🏆" title="Third tile">Used in threes on the landing pages.</twig:FeatureTile>
            </div>
        </twig:Card>

        <twig:Card id="link-cards">
            <twig:SectionHeading title="Link cards" rule />
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                {% for toneName in ['brand', 'flame', 'heat'] %}
                    <twig:LinkCard href="#link-cards" eyebrow="{{ toneName }}" title="A document" tone="{{ toneName }}">
                        The whole card is the link.
                    </twig:LinkCard>
                {% endfor %}
            </div>
        </twig:Card>

        <twig:Card id="disclosure">
            <twig:SectionHeading title="Disclosure & points matrix" rule />
            <div class="space-y-4">
                <twig:Disclosure summary="With medals" icon="📊">
                    <twig:PointsMatrix medals :awards="['25', '18', '15', '12', '10', '8', '6', '4', '2', '1']" />
                </twig:Disclosure>
                <twig:Disclosure summary="Quiet, for a panel with nothing to act on" tone="neutral">
                    <p class="text-xs text-ink-muted">Brand cyan is the interactive accent, so a settled section takes <code class="font-mono">neutral</code>.</p>
                </twig:Disclosure>
                <twig:Disclosure summary="Compact, for dense match rounds" tone="neutral" compact>
                    <p class="text-xs text-ink-muted">Reduced inner padding preserves player-name width on phones.</p>
                </twig:Disclosure>
                <twig:Disclosure summary="Without medals" icon="📊">
                    <twig:PointsMatrix :awards="[
                        '25 points', '20 points *', '15 points', '12 points', '10 points',
                        '8 points', '6 points', '4 points', '2 points', '1 points',
                    ]" />
                </twig:Disclosure>
            </div>
        </twig:Card>

        <twig:Card id="kpi-row">
            <twig:SectionHeading title="KPI row" rule />
            <twig:KpiRow :tiles="[
                {value: 22, label: 'participants'},
                {value: 63, label: 'matches found', highlight: true},
                {value: 668, label: 'points scored'},
                {value: 2, label: 'need a decision'},
            ]" />
        </twig:Card>

        <twig:Card id="form-strip">
            <twig:SectionHeading title="Form strip" rule />
            <div class="flex flex-wrap items-center gap-4">
                <twig:FormStrip :results="['W', 'W', 'L', 'T', 'W']" />
                <twig:FormStrip :results="['W', 'L', 'B', 'W', 'L']" size="xs" />
                <twig:FormStrip :results="[]" />
            </div>
        </twig:Card>

        {% set matchDemo = [
            {match: {challongeId: 1, player1: {name: 'Guzman93'}, player2: {name: 'Sanya'}, player1Score: 8, player2Score: 4, winner: {name: 'Guzman93'}, loser: {name: 'Sanya'}, forfeited: false, consolation: false}, player1_form: ['W', 'W'], player2_form: ['L', 'L']},
            {match: {challongeId: 2, player1: {name: 'Giglio'}, player2: {name: 'Il-Karm'}, player1Score: null, player2Score: null, winner: null, loser: null, forfeited: true, consolation: true}, player1_form: ['W', 'T'], player2_form: ['L', 'T']},
        ] %}
        <twig:Card id="match-log">
            <twig:SectionHeading title="Match log" rule />
            <twig:MatchLog :rows="matchDemo" :byes="[{participant: {name: 'Bankai'}, form: ['W', 'B']}]" />
            <div class="mt-4">
                <twig:MatchLog :rows="matchDemo" strikeLoser />
            </div>
        </twig:Card>

        <twig:Card id="top-cut">
            <twig:SectionHeading title="Top cut" rule />
            <twig:TopCut :matchCount="4" :columns="['QF', 'SF', 'F/3P']" :paths="[
                {participant: {name: 'Guzman93', stageRank: 1}, steps: [
                    {match_id: 1, consolation: false, forfeited: false, result: 'W', own_score: 7, opponent_score: 0, opponent: {name: 'Sk3lli'}, label: 'Quarter-finals', short_label: 'QF', column_label: 'QF'},
                    {match_id: 2, consolation: false, forfeited: false, result: 'W', own_score: 7, opponent_score: 1, opponent: {name: 'Sanya'}, label: 'Semi-finals', short_label: 'SF', column_label: 'SF'},
                    {match_id: 3, consolation: false, forfeited: false, result: 'W', own_score: 8, opponent_score: 6, opponent: {name: 'Giglio'}, label: 'Final', short_label: 'F', column_label: 'F/3P'},
                ]},
                {participant: {name: 'Sk3lli', stageRank: 5}, steps: [
                    {match_id: 1, consolation: false, forfeited: false, result: 'L', own_score: 0, opponent_score: 7, opponent: {name: 'Guzman93'}, label: 'Quarter-finals', short_label: 'QF', column_label: 'QF'},
                ]},
                {participant: {name: 'Sanya', stageRank: 3}, steps: [
                    {match_id: 4, consolation: false, forfeited: true, result: 'W', own_score: null, opponent_score: null, opponent: {name: 'Kemical'}, label: 'Quarter-finals', short_label: 'QF', column_label: 'QF'},
                    {match_id: 2, consolation: false, forfeited: false, result: 'L', own_score: 1, opponent_score: 7, opponent: {name: 'Guzman93'}, label: 'Semi-finals', short_label: 'SF', column_label: 'SF'},
                ]},
            ]" />
            <p class="mt-4 text-xs text-ink-muted">
                An awarded match reads <code class="font-mono">FF</code>, which is the bracket's own word for
                it. A round somebody never reached is an em dash, and the two are not the same thing.
            </p>
        </twig:Card>

        <twig:Card id="player-headline">
            <twig:SectionHeading title="Player headline" rule />
            <twig:PlayerHeadline name="Markinu" :played="99" :wins="69" :losses="30" :opponents="35" class="mb-0" />
            <twig:PlayerHeadline name="Bankai" :played="55" :wins="21" :losses="33" :draws="1" :opponents="31" class="mt-8 mb-0" />
            <twig:PlayerHeadline name="Tristan" class="mt-8 mb-0" />
            <p class="mt-4 text-xs text-ink-muted">
                The career line joins the name and drops <strong>opponents faced</strong> whole below
                <code class="font-mono">sm:</code> rather than abbreviating it. A blader with no archived
                matches gets the name alone. A draw only appears when there is one.
            </p>
        </twig:Card>

        {% set rivalDemo = [
            {opponent: {id: 1, slug: 'blader-1'}, name: 'Markulegend', wins: 7, losses: 3, draws: 0, met: 10},
            {opponent: {id: 2, slug: 'blader-2'}, name: 'Evilbeys', wins: 5, losses: 1, draws: 0, met: 6},
            {opponent: {id: 3, slug: 'blader-3'}, name: 'Claude', wins: 5, losses: 0, draws: 0, met: 5},
            {opponent: {id: 4, slug: 'blader-4'}, name: 'Kaori', wins: 4, losses: 0, draws: 0, met: 4},
            {opponent: {id: 5, slug: 'blader-5'}, name: 'Belti', wins: 3, losses: 1, draws: 0, met: 4},
            {opponent: {id: 6, slug: 'blader-6'}, name: 'Obelix', wins: 2, losses: 1, draws: 1, met: 4},
        ] %}
        <twig:Card id="h2h-bars">
            <twig:SectionHeading title="Head-to-head bars" rule />
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                    <twig:SectionHeading title="Ahead on the head to head" size="sm" tone="positive" />
                    <twig:H2hBars :rivals="rivalDemo" tone="positive" seasonSlug="paid-season" />
                </div>
                <div>
                    <twig:SectionHeading title="Behind on the head to head" size="sm" tone="heat" />
                    <twig:H2hBars :rivals="[
                        {opponent: {id: 7, slug: 'blader-7'}, name: 'Giglio', wins: 2, losses: 4, draws: 0, met: 6},
                        {opponent: null, name: 'Someone unresolved', wins: 0, losses: 1, draws: 0, met: 1},
                    ]" tone="heat" seasonSlug="paid-season" />
                </div>
            </div>
            <p class="mt-4 text-xs text-ink-muted">
                Five rows, then a <code class="font-mono">&lt;details&gt;</code> for the rest — never the
                &ldquo;Show more&rdquo; button, which is the one script this site ships. An opponent nobody has
                resolved to a blader keeps the bracket's spelling and gets no link.
            </p>
        </twig:Card>

        {% set cutDemo = [
            {label: 'QF', outcome: 'W', own_score: 8, opponent_score: 1, forfeited: false, opponent: null, opponent_name: 'Privv', cut: true},
            {label: 'SF', outcome: 'L', own_score: 2, opponent_score: 7, forfeited: false, opponent: null, opponent_name: 'Sanya', cut: true},
            {label: '3P', outcome: 'W', own_score: null, opponent_score: null, forfeited: true, opponent: null, opponent_name: 'Belti', cut: true},
        ] %}
        <twig:Card id="cut-path">
            <twig:SectionHeading title="Cut path" rule />
            <twig:CutPath :steps="cutDemo" />
            <p class="mt-4 text-xs text-ink-muted">
                How far a blader got, one leg per knockout match. The labels come from
                <code class="font-mono">BracketRoundLabels</code>, so a four-round cut numbers its opening
                rounds here exactly as the tournament page's scoreboard does.
            </p>
        </twig:Card>

        <twig:Card id="player-match-log">
            <twig:SectionHeading title="Player match log" rule />
            <twig:PlayerMatchLog seasonSlug="paid-season" :rows="[
                {label: 'R1', outcome: 'W', own_score: 8, opponent_score: 4, forfeited: false, opponent: {id: 1, slug: 'blader-1'}, opponent_name: 'Fir3bladetv', cut: false},
                {label: 'R2', outcome: 'W', own_score: 7, opponent_score: 1, forfeited: false, opponent: {id: 2, slug: 'blader-2'}, opponent_name: 'Guzman93', cut: false},
                {label: 'R3', outcome: 'L', own_score: 6, opponent_score: 7, forfeited: false, opponent: {id: 3, slug: 'blader-3'}, opponent_name: 'Belti', cut: false},
                {label: 'R4', outcome: 'T', own_score: 0, opponent_score: 0, forfeited: false, opponent: {id: 4, slug: 'blader-4'}, opponent_name: 'Obelix', cut: false},
                {label: 'R5', outcome: 'W', own_score: null, opponent_score: null, forfeited: true, opponent: null, opponent_name: 'Bye', cut: false},
            ]" />
            <p class="mt-4 text-xs text-ink-muted">
                The same log as <code class="font-mono">MatchLog</code>, told from one blader's side, because
                a career page has a subject and a tournament page does not. A win at 8 or better is tinted
                amber; an awarded match reads <code class="font-mono">FF</code>.
            </p>
        </twig:Card>

        <twig:Card id="event-feed">
            <twig:SectionHeading title="Event feed" rule />
            <twig:EventFeed seasonSlug="paid-season" :initial="2" :events="[
                {
                    tournament: {id: 1, title: 'Gamebreaker 22-08', heldOn: date('2026-08-22'), ranked: true, season: {slug: 'paid-season', name: 'Season 1'}},
                    archived: true, wins: 7, losses: 1, draws: 0, rank: 3, points: 25,
                    stage_rank: 3, stage_label: 'Swiss', won_the_cut: true, cut: cutDemo,
                    stages: [{label: 'Top cut', matches: cutDemo}],
                },
                {
                    tournament: {id: 2, title: 'Gamesplus 26-07', heldOn: date('2026-07-26'), ranked: true, season: {slug: 'preseason-1', name: 'Preseason 1'}},
                    archived: true, wins: 2, losses: 3, draws: 0, rank: null, points: null,
                    stage_rank: 15, stage_label: 'Swiss', won_the_cut: false, cut: [],
                    stages: [{label: 'Swiss', matches: cutDemo|slice(0, 2)}],
                },
                {
                    tournament: {id: 3, title: '19th July Gamesplus 2v2', heldOn: date('2026-07-19'), ranked: true, season: {slug: 'paid-season', name: 'Season 1'}},
                    archived: false, wins: 0, losses: 0, draws: 0, rank: 1, points: 25,
                    stage_rank: null, stage_label: null, won_the_cut: false, cut: [], stages: [],
                },
                {
                    tournament: {id: 4, title: 'Malta International Exhibition', heldOn: date('2026-07-12'), ranked: false, season: null},
                    archived: true, wins: 3, losses: 2, draws: 0, rank: null, points: null,
                    stage_rank: 4, stage_label: 'Swiss', won_the_cut: false, cut: [],
                    stages: [{label: 'Swiss', matches: cutDemo|slice(0, 2)}],
                },
            ]" />
            <p class="mt-4 text-xs text-ink-muted">
                The career's match history, not a summary of it: every match is inside one of these panels.
                <code class="font-mono">&lt;details&gt;</code> is native, so the whole history is reachable
                with JavaScript off. A 2v2 evening archives no matches and says so; an event from another
                season names it, and an unranked one is marked as such and carries no points. The profile
                shows the newest three and folds the rest away — shown here
                with <code class="font-mono">initial</code> at two, so the fold has something to hold.
            </p>
        </twig:Card>

        <twig:Card id="totals-list">
            <twig:SectionHeading title="Totals list" rule />
            <twig:TotalsList :rows="[
                {label: 'Group stage', note: 'Group A · swiss · 5 rounds · 22 entrants', value: '55 matches'},
                {label: 'Top cut', note: 'single elimination · 3 rounds · 8 entrants', value: '8 matches'},
                {label: 'Standings rows', value: '30'},
                {label: 'Byes and forfeits', note: 'shown as B in Swiss history · awarded matches use FF', value: 'B · FF'},
            ]" />
        </twig:Card>

        {# Hashes rather than entities: the styleguide has no controller, and
           every one of these components reads its data by key. #}
        {% set seasonDemo = [
            {name: 'Preseason 1', slug: 'preseason-1'},
            {name: 'Season 1', slug: '1'},
        ] %}
        <twig:Card id="scope-switch">
            <twig:SectionHeading title="Scope switch" rule />
            <div class="space-y-4">
                <twig:ScopeSwitch route="records_board" :seasons="seasonDemo" />
                <twig:ScopeSwitch route="records_board" :seasons="seasonDemo" activeSlug="1" />
            </div>
            <p class="mt-4 text-xs text-ink-muted">
                Links, not a control — the scope lives in the URL, so every scope is reachable and
                back-buttonable without a line of JavaScript. The active one carries
                <code class="font-mono">aria-current</code> as well as the tint.
            </p>
        </twig:Card>

        <twig:Card id="finishing-order">
            <twig:SectionHeading title="Finishing order" rule />
            <twig:FinishingOrder :rows="[
                {rank: 1, name: 'Giglio', player: null, matches: 5, wins: 5, losses: 0, draws: 0, form: ['W', 'W', 'W', 'W', 'W']},
                {rank: 2, name: 'Sanya', player: null, matches: 5, wins: 4, losses: 1, draws: 0, form: ['W', 'L', 'W', 'W', 'W']},
                {rank: 3, name: 'Jape', player: null, matches: 5, wins: 4, losses: 1, draws: 0, form: ['W', 'W', 'L', 'W', 'W']},
                {rank: 4, name: 'Federico', player: null, matches: 0, wins: 0, losses: 0, draws: 0, form: []},
            ]" />
            <p class="mt-4 text-xs text-ink-muted">
                Where the bracket says everybody finished, on a page where that pays nothing.
                <strong class="text-ink-muted">No F1, bonus or total column</strong> — an unranked event
                writes no result row, so there is no such value to put in one. The fourth row is an
                entrant the archive holds no matches for.
            </p>
        </twig:Card>

        <twig:Card id="archive-row">
            <twig:SectionHeading title="Archive row" rule />
            <twig:ArchiveRow :events="[
                {id: 1, title: 'Gamesplus 23-08', heldOn: date('2026-08-23'), entrants: 31, matches: 87, teams: 0, knockoutWinner: 'Giglio', ranked: true},
                {id: 2, title: '19th July Gamesplus 2v2', heldOn: date('2026-07-19'), entrants: 0, matches: 0, teams: 11, knockoutWinner: null, ranked: true},
                {id: 3, title: 'Malta International Exhibition', heldOn: date('2026-08-16'), entrants: 12, matches: 24, teams: 0, knockoutWinner: null, ranked: false},
            ]" />
            <p class="mt-4 text-xs text-ink-muted">
                The ranked/unranked mark rides in the name cell rather than in a column of its own:
                a column empty on nineteen rows in twenty is a column spent badly at 375px. A 2v2
                evening archives no matches, and an unranked one has no result row to name a
                knockout winner from.
            </p>
        </twig:Card>

        <twig:Card id="season-index">
            <twig:SectionHeading title="Season index" rule />
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <twig:SeasonIndex :card="{
                    season: {slug: '1', name: 'Season 1'},
                    events: 16, matches: 945,
                    from: date('2026-07-04'), to: date('2026-08-23'),
                    winner: 'Markinu', points: 150, current: true,
                }" />
                <twig:SeasonIndex :card="{
                    season: {slug: 'preseason-1', name: 'Preseason 1'},
                    events: 4, matches: 197,
                    from: date('2026-06-20'), to: date('2026-06-28'),
                    winner: 'Markinu', points: 60, current: false,
                }" />
                <twig:SeasonIndex :card="{
                    season: {slug: '2', name: 'Season 2'},
                    events: 0, matches: 0,
                    from: null, to: null,
                    winner: null, points: null, current: false,
                }" />
            </div>
            <p class="mt-4 text-xs text-ink-muted">
                Switching season is navigation rather than a control, so a card carries enough to
                choose between two seasons without opening either. The running season says
                <em>Leading</em> where a finished one says <em>Won by</em>; a season nobody has
                scored in yet names nobody rather than a zero-point leader.
            </p>
        </twig:Card>

        <twig:Card id="record-tile">
            <twig:SectionHeading title="Record tile" rule />
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <twig:RecordTile label="Highest win rate" name="Mezz" value="70.6%" note="24–10 in 34 matches" tone="brand" :leaders="[
                    {player: null, name: 'Mezz', value: '70.6%'},
                    {player: null, name: 'Markinu', value: '68.2%'},
                    {player: null, name: 'Sk3lli', value: '65.9%'},
                ]" />
                <twig:RecordTile label="Most 9-point finishes" name="Markulegend" value="7" note="of the 71 anyone has scored" :leaders="[
                    {player: null, name: 'Markulegend', value: '7'},
                    {player: null, name: 'Guzman93', value: '6'},
                    {player: null, name: 'Mezz', value: '5'},
                ]" />
                <twig:RecordTile label="Best points differential" name="Markinu" value="+169" note="555 scored, 386 conceded" tone="positive" />
                <twig:RecordTile label="Most one-sided rivalry" name="Markinu over Evilbeys" value="5–0" note="met 5 times, never beaten" />
                <twig:RecordTile label="Longest win streak" value="10 straight" name="Markinu" note="across 2 events" />
                <twig:RecordTile label="Most shutout wins" />
            </div>
            <p class="mt-4 text-xs text-ink-muted">
                The last tile is a record nobody in scope holds. It renders rather than disappearing, so a
                quiet season is the same board as a busy one.
            </p>
        </twig:Card>

        {# The commands carry single quotes of their own, so they are built
           here rather than inline in a component attribute, where Twig parses
           the nested quoting as markup. #}
        {% set ledgerDemo = [
            "php bin/console app:create-blader 'Sk3lli'",
            "php bin/console app:archive-challonge 'nppk0890'",
        ] %}

        <twig:Card id="artifacts">
            <twig:SectionHeading title="Artifacts & ledger" rule />
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <twig:ArtifactList :artifacts="[
                    {verb: 'write', path: 'var/data/challonge/nppk0890.json'},
                    {verb: 'replace', path: 'var/data/imports/2026-08-16-gamesplus-16-08.txt'},
                    {verb: 'append', path: 'var/log/command_ledger.sh'},
                ]" />
                <twig:LedgerLine :commands="ledgerDemo" />
            </div>
        </twig:Card>

        <twig:Card id="empty-state">
            <twig:SectionHeading title="Empty state" rule />
            <twig:EmptyState title="Ledger unpopulated">
                Shown where a list would be when there is nothing to list.
            </twig:EmptyState>
        </twig:Card>

    </div>

{% endblock %}
