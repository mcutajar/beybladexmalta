{#
    The import preview: one page, top to bottom, in the order somebody checks
    it.

    Nothing here is hidden behind a second click except the entrants who score
    nothing, and nothing here has been written. The whole page is one form, so
    the decisions, the finishing order, the knockout winner and the passphrase
    are one submission — there is no half-applied state to get into.
#}
{% extends 'base.html.twig' %}

{% block title %}MBC Terminal | Review {{ preview.slug }}{% endblock %}

{% block column %}max-w-4xl px-3 py-6 sm:px-4 md:py-12{% endblock %}

{% block body %}

    <twig:BackLink href="{{ path('admin_tournament_import') }}" class="mb-6">Return to the importer</twig:BackLink>

    <twig:PageHeader eyebrow="Administrative import · review" title="Review before importing" size="sm">
        Nothing has been written. {{ preview.title }} &middot; {{ preview.heldOn }}
    </twig:PageHeader>

    <twig:Flashes />

    {{ form_start(confirm_form, {'action': path('admin_bracket_confirm'), 'attr': {'class': 'space-y-6'}}) }}

    {{ form_widget(confirm_form.slug) }}

    {# ── Which bracket was fetched, and what came back ───────────────── #}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 rounded-field border border-line bg-canvas px-4 py-3">
        <span class="text-[11px] font-bold uppercase tracking-wider text-ink-faint">Bracket</span>
        <a href="{{ preview.bracketUrl }}" target="_blank" rel="noopener noreferrer"
           class="min-w-0 truncate font-mono text-sm text-brand transition-colors hover:text-brand-bright">{{ preview.bracketUrl }}</a>
        <twig:Badge tone="positive" size="sm" class="sm:ml-auto">Fetched &middot; {{ preview.shape }}</twig:Badge>
    </div>

    <twig:KpiRow :tiles="[
        {value: preview.participants, label: 'entrant rows'},
        {value: preview.matches, label: 'matches found', highlight: true},
        {value: preview.pointsScored, label: 'points scored'},
        {value: preview.decisions|length, label: 'need a decision'},
    ]" />

    {# ── Every name the league cannot read ───────────────────────────── #}
    {% set outstanding = preview.outstanding %}
    {% set settled = preview.settled %}

    {% if preview.decisions is not empty %}
        <twig:Card class="{{ outstanding is empty ? 'border-line' : 'border-flame-strong/30' }}">
            <div class="mb-4 space-y-2">
                <twig:SectionHeading
                    title="{{ outstanding is empty ? 'Nothing left to decide' : 'Decisions required' }}"
                    tone="{{ outstanding is empty ? 'positive' : 'flame' }}"
                    size="sm"
                />
                <p class="text-xs text-ink-muted">
                    {% if outstanding is not empty %}
                        <strong class="text-ink-body">{{ outstanding|length }}
                        {{ outstanding|length == 1 ? 'name needs' : 'names need' }} you.</strong>
                        Each one is a blader the league already knows, somebody new, or not a person at all.
                        The suggestion is offered first and is still a tap &mdash; on the 23 August bracket one
                        suggestion in four was two different people.
                    {% else %}
                        Every name is answered. Check the defaults below before you commit.
                    {% endif %}
                </p>
            </div>

            {% if outstanding is not empty %}
                <ul>
                    {% for decision in outstanding %}
                        {{ include('admin/_decision_row.html.twig', {decision: decision, bladers: bladers, elsewhere: elsewhere}) }}
                    {% endfor %}
                </ul>
            {% endif %}

            {% if settled is not empty %}
                <twig:Disclosure
                    summary="{{ settled|length }} with nothing close — review"
                    icon="✓"
                    tone="neutral"
                    class="{{ outstanding is empty ? '' : 'mt-5' }}"
                >
                    <p class="mb-4 text-xs leading-relaxed text-ink-faint">
                        Nothing in the league came close to these, so each is taken to be somebody new.
                        That is the safe way round: an unnecessary blader is a duplicate row you can see and merge,
                        while an unnecessary alias welds two people together and cannot be undone.
                        <strong class="text-ink-muted">It is still wrong sometimes</strong> &mdash; a spelling more than
                        two edits from a blader's name is offered nothing at all &mdash; so use
                        <em>Someone else</em> on any row you recognise.
                    </p>

                    <ul>
                        {% for decision in settled %}
                            {{ include('admin/_decision_row.html.twig', {decision: decision, bladers: bladers, elsewhere: elsewhere}) }}
                        {% endfor %}
                    </ul>
                </twig:Disclosure>
            {% endif %}
        </twig:Card>
    {% else %}
        <twig:Alert tone="positive">Every name on this bracket reaches a blader the league already knows.</twig:Alert>
    {% endif %}

    {# ── The finishing order, with the matrix already applied ────────── #}
    <twig:Card>
        <div class="mb-4 space-y-1">
            <twig:SectionHeading title="Placements & points" size="sm" />
            <p class="text-xs text-ink-faint">
                Seeded from the bracket's own standings. The top {{ preview.scoring|length }} score;
                change a number to move somebody.
            </p>
        </div>

        <twig:DataTable bleed>
            <thead>
            <tr>
                <th class="w-16 text-center">#</th>
                <th>Blader</th>
                <th class="hidden sm:table-cell">On Challonge</th>
                <th class="text-center">F1</th>
                <th class="hidden text-center sm:table-cell">Bonus</th>
                <th class="pr-4 text-right font-bold text-brand">Total</th>
            </tr>
            </thead>
            <tbody>
            {% for placement in preview.placements|filter(row => row.scores) %}
                {{ include('admin/_placement_row.html.twig', {placement: placement}) }}
            {% endfor %}
            </tbody>
        </twig:DataTable>

        {% set unscored = preview.placements|filter(row => not row.scores) %}

        {% if unscored is not empty %}
            <twig:Disclosure summary="{{ unscored|length }} more, archived but unscored" icon="🗄️" class="mt-4">
                <twig:DataTable bleed>
                    <thead>
                    <tr>
                        <th class="w-16 text-center">#</th>
                        <th>Blader</th>
                        <th class="hidden sm:table-cell">On Challonge</th>
                        <th class="text-center">F1</th>
                        <th class="hidden text-center sm:table-cell">Bonus</th>
                        <th class="pr-4 text-right font-bold text-brand">Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for placement in unscored %}
                        {{ include('admin/_placement_row.html.twig', {placement: placement}) }}
                    {% endfor %}
                    </tbody>
                </twig:DataTable>
            </twig:Disclosure>
        {% endif %}
    </twig:Card>

    {# ── What the archive will hold, and what will be written ────────── #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <twig:Card size="sm">
            <twig:SectionHeading title="Will be archived" size="sm" tone="neutral" />
            <twig:TotalsList :rows="preview.archive" />
        </twig:Card>

        <twig:Card size="sm">
            <twig:SectionHeading title="Recovery artifacts" size="sm" tone="neutral" />
            <twig:ArtifactList :artifacts="preview.artifacts" />
            <p class="mt-3 text-[11px] italic leading-relaxed text-ink-faint">
                Each write is inside its own flush transaction, so a failed artifact write undoes the change it records.
            </p>
        </twig:Card>
    </div>

    {# ── The lines that will land in repeat.sh ───────────────────────── #}
    <twig:Card size="sm">
        <twig:SectionHeading title="Ledger" size="sm" tone="neutral" />
        <twig:LedgerLine :commands="preview.ledger" />
        <p class="mt-3 text-[11px] italic leading-relaxed text-ink-faint">
            Appended in this order, which is the order they replay in. The league is rebuilt by running these against an empty schema.
        </p>
    </twig:Card>

    {# ── Confirm ─────────────────────────────────────────────────────── #}
    <twig:Card variant="gradient">
        <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <twig:Field label="Overall knockout winner" hint="Detected from the last match of the cut.">
                    {{ form_widget(confirm_form.knockoutWinner) }}
                </twig:Field>
                <twig:Field label="System access key">
                    {{ form_widget(confirm_form.passphrase) }}
                </twig:Field>
            </div>

            {% if preview.isBlocked %}
                <twig:Alert tone="flame">
                    {{ outstanding|length }} {{ outstanding|length == 1 ? 'name is' : 'names are' }} still unanswered.
                    Nothing can be written until every one of them is settled.
                </twig:Alert>
            {% elseif preview.bladersToCreate > 0 %}
                <twig:Alert tone="brand">
                    This will create {{ preview.bladersToCreate }} new
                    {{ preview.bladersToCreate == 1 ? 'blader' : 'bladers' }}{% if preview.seeded > 0 %},
                    {{ preview.seeded }} of {{ preview.bladersToCreate == preview.seeded ? 'them' : 'those' }} by default{% endif %}.
                    This screen is the only thing in the system that creates one.
                </twig:Alert>
            {% endif %}

            <div class="flex flex-col gap-3 border-t border-line/60 pt-4 sm:flex-row-reverse">
                <twig:Button tone="flame" class="w-full sm:w-auto">
                    Import {{ preview.scoring|length }} &amp; archive {{ preview.matches }} ✓
                </twig:Button>
                <button type="submit" name="cancel" value="1" formnovalidate
                        class="inline-flex w-full cursor-pointer items-center justify-center rounded-field border border-line bg-surface px-5 py-3 text-sm font-black uppercase tracking-wider text-ink-muted transition-colors hover:border-ink-ghost hover:text-ink sm:w-auto">
                    Cancel
                </button>
            </div>
        </div>
    </twig:Card>

    {# render_rest: false keeps Symfony from injecting the widgets already placed above. #}
    {{ form_end(confirm_form, {'render_rest': false}) }}

{% endblock %}
