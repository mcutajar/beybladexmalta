{% extends 'base.html.twig' %}

{% block title %}MBC League | Remote Registration Management{% endblock %}

{% block column %}max-w-2xl px-3 py-8 sm:px-4 md:py-16{% endblock %}

{% block body %}

    <twig:BackLink href="{{ path('app_league_proposal_v2') }}" class="mb-8">Return to hub</twig:BackLink>

    <twig:PageHeader eyebrow="Administrative terminal" title="Remote payment terminal" size="md">
        Log financial clearances remotely. Transactions auto-append directly into the app disaster recovery log ledger.
    </twig:PageHeader>

    <twig:Flashes />

    <twig:Card variant="gradient">
        {{ form_start(registration_form, {
            'action': path('admin_register_payment'),
            'method': 'POST',
            'attr': {'class': 'space-y-6'}
        }) }}

        <twig:Field label="Target competitive season">
            {{ form_widget(registration_form.season) }}
        </twig:Field>

        <twig:Field
            label="Blader identification name"
            hint="If the input identity doesn't exist in the database repository maps, a clean baseline profile token automatically initializes."
        >
            {{ form_widget(registration_form.playerName) }}
        </twig:Field>

        <twig:Field label="System access key">
            {{ form_widget(registration_form.passphrase) }}
        </twig:Field>

        <div class="pt-4">
            <twig:Button class="w-full">Verify &amp; process payment dues ✓</twig:Button>
        </div>

        {{ form_end(registration_form) }}
    </twig:Card>

{% endblock %}
