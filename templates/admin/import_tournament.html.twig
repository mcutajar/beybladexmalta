<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>MBC Terminal | Tournament Import</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body class="min-h-full font-sans antialiased text-sm selection:bg-cyan-500 selection:text-slate-950">

<div class="h-1.5 bg-gradient-to-r from-cyan-500 via-amber-500 to-red-500 w-full"></div>

<main class="w-full max-w-2xl mx-auto px-3 py-6 md:py-12">

    <!-- Nav Row -->
    <div class="mb-6">
        <a href="/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-400 hover:text-white transition-colors">
            ⬅ Return to Hub
        </a>
    </div>

    <!-- Title Group -->
    <header class="text-center mb-6 space-y-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-950 text-amber-400 border border-amber-800/60 uppercase tracking-wider">
            Ranked Data Loader
        </span>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white uppercase">
            Import Tournament Standings
        </h1>
        <p class="text-slate-400 text-xs max-w-md mx-auto px-2">
            Input tournament brackets below. The calculator requires exactly 10 bladers to apply the F1 point tiers correctly.
        </p>
    </header>

    <!-- Flashes Container -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-3.5 rounded-xl text-xs sm:text-sm font-bold border
                {% if label == 'success' %} bg-emerald-500/10 text-emerald-400 border-emerald-500/20
                {% elseif label == 'error' %} bg-red-500/10 text-red-400 border-red-500/20
                {% else %} bg-cyan-500/10 text-cyan-400 border-cyan-500/20 {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Mobile Optimized Responsive Card Form wrapper -->
    <div class="bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800/60 rounded-xl p-4 sm:p-6 shadow-2xl">

        {{ form_start(import_form, {'attr': {'class': 'space-y-4'}}) }}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Tournament Title</label>
                {{ form_widget(import_form.title) }}
            </div>
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Date Held On</label>
                {{ form_widget(import_form.date) }}
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Target Season Context</label>
                {{ form_widget(import_form.season) }}
            </div>
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Challonge URL</label>
                {{ form_widget(import_form.challongeUrl) }}
            </div>
        </div>

        <div class="space-y-1.5">
            <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Overall Knockout Winner</label>
            {{ form_widget(import_form.knockoutWinner) }}
        </div>

        <div class="space-y-1.5">
            <div class="flex justify-between items-center">
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Ordered Placements (Exactly 10 Lines)</label>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 font-mono text-slate-400">F1 System</span>
            </div>
            {{ form_widget(import_form.playerList) }}
            <p class="text-[11px] text-slate-500 italic leading-snug">Enter one blader name per line in finishing order (1st down to 10th). Do not include extra numbers or commas.</p>
        </div>

        <div class="space-y-1.5 pt-1">
            <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">System Access Key</label>
            {{ form_widget(import_form.passphrase) }}
        </div>

        <!-- High Contrast Submit Action Button -->
        <div class="pt-4 border-t border-slate-900">
            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black uppercase tracking-wider text-xs sm:text-sm py-3.5 px-4 rounded-xl shadow-[0_4px_20px_rgba(245,158,11,0.25)] transition-all transform active:scale-[0.99] block cursor-pointer text-center border border-amber-600">
                Process Calculations & Commit ✓
            </button>
        </div>

        {# Passing render_rest: false stops Symfony from injecting hidden trailing markup layouts #}
        {{ form_end(import_form, {'render_rest': false}) }}
    </div>

    {{ include('_footer.html.twig') }}

</main>
</body>
</html>
