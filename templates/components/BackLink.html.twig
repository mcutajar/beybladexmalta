{#
    The "return to …" pill.

    <twig:BackLink href="{{ path('season_leaderboard') }}">Return to hub</twig:BackLink>

    `min-h-11` makes it a 44px touch target on a phone; the pointer case tightens
    back up at `sm:`.
#}
{% props href = '/' %}

<a href="{{ href }}" {{ attributes.defaults({
    class: 'inline-flex min-h-11 items-center gap-2 rounded-control border border-line bg-surface px-3 py-1.5 text-xs font-semibold text-ink-muted transition-colors hover:border-line hover:text-ink sm:min-h-0',
}) }}>
    <span aria-hidden="true">&larr;</span>{% block content %}{% endblock %}
</a>
